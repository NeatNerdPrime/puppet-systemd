<%- |
 Optional[Hash] $unit_entry        = undef,
 Optional[Hash] $manager_entry     = undef,
 Optional[Hash] $slice_entry       = undef,
 Optional[Hash] $service_entry     = undef,
 Optional[Hash] $install_entry     = undef,
 Optional[Hash] $timer_entry       = undef,
 Optional[Hash] $path_entry        = undef,
 Optional[Hash] $socket_entry      = undef,
 Optional[Hash] $automount_entry   = undef,
 Optional[Hash] $mount_entry       = undef,
 Optional[Hash] $swap_entry        = undef,
 Optional[Array[String]] $comments = undef,
| -%>
<%-

 # List of possible of unit sections, should match the list of _entry variables
 # above.

 $_unit_sections = [
   'Unit',
   'Manager',
   'Slice',
   'Service',
   'Timer',
   'Path',
   'Socket',
   'Automount',
   'Mount',
   'Swap',
   'Install',
]

# Directives which are pair of items to be expressed as a space separated pair.
$_tupled_values = [
  'IODeviceWeight',
  'IOReadBandwidthMax',
  'IOWriteBandwidthMax',
  'IOReadIOPSMax',
  'IOWriteIOPSMax',
]

-%>
# Deployed with puppet<%# DO NOT EDIT THIS HEADER! The `systemd_purge_units` type depends on it. %>
<% if $comments { -%>
#
<%   $comments.each |$msg| { -%>
# <%= $msg %>
<%   } -%>
<% } -%>
#
<%-
$_unit_sections.each | $_section | {
  $_values = getvar("${downcase($_section)}_entry")
  if $_values {
    -%>

[<%= $_section %>]
    <%-

    # De-tuple the tupled values to space seperation
    $_myvalues = $_values.map | $_key, $_value | {
      if $_key in $_tupled_values {
        if $_value =~ Array[Tuple[String[1],Variant[Integer,String[1]]]] {
          { $_key =>  $_value.map | $_inner_value | {  "${_inner_value[0]} ${_inner_value[1]}" } }
        } else {
          {$_key => "${_value[0]} ${_value[1]}"}
        }
      } else {
        {$_key => $_value}
      }
    }.reduce | $_memo, $_value | { $_memo + $_value }

    if $_myvalues {
      $_myvalues.each | $_key, $_value | {
        Array($_value, true).each | $_subvalue | {
        -%>
<%= $_key %>=<%= $_subvalue %>
        <%-
        }
      }
    }
  }
}
-%>
